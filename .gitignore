__pycache__/
.DS_Store
*.pyc

# Working notes and trackers stay internal. Publish the products, never the tracker
# (matches keystone and power-service-toolbox).
mission-control/
SHELF.md

# Staging for tools/merge_candidates.py. Proposed documents from wherever, plus the rejects it
# writes back. This is PROCESS, and catalog.csv is the PRODUCT: a candidate is something somebody
# claimed, a row is something that was fetched. Publishing the claims next to the records invites
# exactly the confusion this repo exists to prevent, so the staging area never ships.
catalog/_incoming/

# THE PUBLISH BOUNDARY OF THIS REPO.
#
# mirrors/ holds document files. A document file is a copyright liability unless its catalog row
# says redistributable=yes with a stated license. Nothing lands in mirrors/ by accident: it is
# ignored by default and each cleared file is force added on purpose.
#
#   git add -f mirrors/<path>     only after tools/check_mirrors.py passes on it
#
# tools/gate.sh fails if a tracked file in mirrors/ has no catalog row clearing it, so this
# ignore rule is the seatbelt and the gate is the airbag.
mirrors/*
!mirrors/README.md
!mirrors/.gitkeep

# Fetched candidates awaiting a license decision. Never publishable by definition.
staging/
